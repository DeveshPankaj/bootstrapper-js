/** /bin/history.run */
const terminal = platform.getService('terminal');
const fs = platform.host.getFS();
const write = terminal ? terminal.write.bind(terminal) : console.log;
const [pwd, ...rest] = $args;

// Fixed at the home directory, like real bash's $HISTFILE - not cwd-relative
// (this used to be `${pwd}/.bash_history`, which meant `cd`ing anywhere and
// running `history` created/read a *different* .bash_history file in that
// directory instead of the one the terminal app itself reads/appends to at
// boot/exit, see HISTORY_FILE in /opt/apps/terminal/main.html).
const historyFile = '/home/user1/.bash_history';

// Ensure the history file exists
if (!fs.existsSync(historyFile)) {
  fs.writeFileSync(historyFile, '');
}

// Read and display command history from the file
const history = fs.readFileSync(historyFile, 'utf8').split('\n').filter(Boolean);

if (history.length === 0) {
  write('No command history.\r\n');
} else {
  // Display each command in the history with an index number
  history.forEach((cmd, index) => {
    write(`${index + 1}  ${cmd}\r\n`);
  });
}
